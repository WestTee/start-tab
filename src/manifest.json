{
  "manifest_version": 3,
  "name": "Start Tab",
  "short_name": "Start Tab",
  "version": "0.3.0",
  "description": "A full-screen new tab page built from a bookmarks folder. Each subfolder becomes a section of tiles.",
  "permissions": ["bookmarks", "favicon", "storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "104"
}
